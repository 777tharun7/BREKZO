# Local Docker Compose defaults for development only.
# Replace both password values and keep POSTGRES_PASSWORD / DATABASE_URL synchronized.
# Use a URL-safe password (letters/numbers/_/-) unless you URL-encode reserved characters in DATABASE_URL.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=food_app_db
DATABASE_URL=postgresql://postgres:change-this-local-password@db:5432/food_app_db
